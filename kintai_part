      { pin: '7912', name: '綱代愛',      dept: 'りゅうちゃん',        locs: [{ lat: 35.8998, lng: 140.6404, name: '神栖横丁', radius: 300 }] },
      { pin: '1520', name: '新河美和',    dept: 'りゅうちゃん',        locs: [{ lat: 35.8998, lng: 140.6404, name: '神栖横丁', radius: 300 }] },
      { pin: '1488', name: '飯塚利恵',    dept: 'りゅうちゃん',        locs: [{ lat: 35.8998, lng: 140.6404, name: '神栖横丁', radius: 300 }] },
