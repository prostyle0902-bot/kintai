      { pin: '3045', name: '望月辰雄',    dept: 'ニッセーデリカ',      locs: null },
      { pin: '7201', name: '岸本敏男',    dept: 'ニッセーデリカ',      locs: null },
      { pin: '2291', name: '高野由美',    dept: 'ニッセーデリカ',      locs: null },
      { pin: '5803', name: '村田耕一',    dept: 'ニッセーデリカ',      locs: null },
      { pin: '6925', name: '池田久史',    dept: '本社',               locs: [{ lat: 35.8580, lng: 140.5625, name: '本社', radius: 300 }] },
      { pin: '4150', name: '三浦達弥',    dept: '本社',               locs: [{ lat: 35.8580, lng: 140.5625, name: '本社', radius: 300 }] },
    ];

    let pinBuffer = '';
    let currentEmp = null;
    let todayIn = null;
    let todayOut = null;
    let prevDayNoOut = false;
    let applyType = '出勤';

    function pinInput(n) {
      if (pinBuffer.length >= 4) return;
      pinBuffer += n;
      updateDots();
      if (pinBuffer.length === 4) setTimeout(checkPin, 150);
    }

    function pinDel() {
      pinBuffer = pinBuffer.slice(0, -1);
      updateDots();
      document.getElementById('pin-error').textContent = '';
    }

    function updateDots() {
      for (let i = 0; i < 4; i++) {
        document.getElementById('d' + i).classList.toggle('filled', i < pinBuffer.length);
      }
    }

    function checkPin() {
      const emp = employees.find(e => e.pin === pinBuffer);
      if (emp) {
        currentEmp = emp;
        document.getElementById('emp-name').textContent = emp.name + ' さん';
        document.getElementById('emp-dept-badge').textContent = emp.dept;
        todayIn = null; todayOut = null; prevDayNoOut = false;
        document.getElementById('btn-in').disabled = false;
        document.getElementById('btn-out').disabled = false;
        updateStatus();
        showScreen('screen-punch');

        // ログイン時に打刻状況取得
        const d = new Date();
        const dateStr = d.getFullYear() + '/' + String(d.getMonth()+1).padStart(2,'0') + '/' + String(d.getDate()).padStart(2,'0');
        fetch(GAS_URL, {
          method: 'POST', mode: 'cors',
          headers: { 'Content-Type': 'text/plain' },
          body: JSON.stringify({ action: 'getStatusPA', name: emp.name, date: dateStr }),
        })
        .then(r => r.json())
        .then(res => {
          if (res.status === 'ok') {
            if (res.inTime) { todayIn = res.inTime; document.getElementById('btn-in').disabled = true; }
            if (res.outTime) { todayOut = res.outTime; document.getElementById('btn-out').disabled = true; }
            prevDayNoOut = res.prevDayNoOut || false;
            updateStatus();
          }
        })
        .catch(() => {});
      } else {
        document.getElementById('pin-error').textContent = 'PINコードが違います';
        pinBuffer = '';
        updateDots();
      }
    }

    function showScreen(id) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById(id).classList.add('active');
    }

    function getTimeStr(type) {
      const now = new Date();
      let h = now.getHours();
      let m = now.getMinutes();
      if (type === '出勤') {
        m = Math.ceil(m / 15) * 15;
        if (m === 60) { m = 0; h += 1; }
      } else {
        m = Math.floor(m / 15) * 15;
      }
      return String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0');
    }

    function updateStatus() {
      document.getElementById('st-in').textContent = todayIn || '未打刻';
      document.getElementById('st-out').textContent = todayOut || '未打刻';
    }

    function calcDist(lat1, lng1, lat2, lng2) {
      const R = 6371000;
      const dLat = (lat2-lat1)*Math.PI/180;
      const dLng = (lng2-lng1)*Math.PI/180;
      const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)**2;
      return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
    }

    function punch(type) {
      // 退勤：出勤未打刻チェック
      if (type === '退勤' && !todayIn) {
        if (!confirm('⚠️ 出勤が記録されていません。\n打刻忘れ申請画面に移動しますか？')) return;
        showApply(); return;
      }
      // 出勤：前日退勤未打刻チェック
      if (type === '出勤' && prevDayNoOut) {
        alert('⚠️ 前日の退勤が記録されていません。\n打刻忘れ申請をしてください。');
        showApply(); return;
      }

      const allowedLocs = currentEmp.locs;
      if (allowedLocs === null) { doPunch(type, null); return; }

      document.getElementById('btn-in').disabled = true;
      document.getElementById('btn-out').disabled = true;

      if (!navigator.geolocation) {
        alert('位置情報に対応していません');
        document.getElementById('btn-in').disabled = false;
        document.getElementById('btn-out').disabled = false;
        return;
      }

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          let nearest = null, minDist = Infinity;
          for (const loc of allowedLocs) {
            const dist = calcDist(lat, lng, loc.lat, loc.lng);
            if (dist < minDist) { minDist = dist; nearest = loc; }
            if (dist <= loc.radius) { doPunch(type, { lat, lng, place: loc.name }); return; }
          }
          document.getElementById('btn-in').disabled = false;
          document.getElementById('btn-out').disabled = false;
          alert('打刻できる場所にいません\n最寄り「' + nearest.name + '」まで約' + Math.round(minDist) + 'm');
        },
        () => {
          document.getElementById('btn-in').disabled = false;
          document.getElementById('btn-out').disabled = false;
          alert('位置情報を取得できませんでした');
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    }

    function doPunch(type, geoInfo) {
      const t = getTimeStr(type);
      if (type === '出勤') { todayIn = t; document.getElementById('btn-in').disabled = true; }
      else { todayOut = t; document.getElementById('btn-out').disabled = true; }
      updateStatus();
      document.getElementById('done-title').textContent = type + 'を記録しました';
      document.getElementById('done-time').textContent = '記録時刻: ' + t;
      document.getElementById('done-icon').textContent = type === '出勤' ? '✅' : '🏁';
      showScreen('screen-done');

      const d = new Date();
      const dateStr = d.getFullYear() + '/' + String(d.getMonth()+1).padStart(2,'0') + '/' + String(d.getDate()).padStart(2,'0');
      fetch(GAS_URL, {
        method: 'POST', mode: 'cors',
        headers: { 'Content-Type': 'text/plain' },
        body: JSON.stringify({
          action: 'punchPA',
          date: dateStr, name: currentEmp.name, dept: currentEmp.dept,
          type: type, time: t,
          lat: geoInfo ? geoInfo.lat : null,
          lng: geoInfo ? geoInfo.lng : null,
          place: geoInfo ? geoInfo.place : 'フリー',
        }),
      })
      .then(r => r.json())
      .then(res => {
        if (res.status === 'duplicate') {
          // 上書き確認
          if (confirm('⚠️ ' + res.message + '\n上書きしますか？')) {
            const d2 = new Date();
            const ds2 = d2.getFullYear() + '/' + String(d2.getMonth()+1).padStart(2,'0') + '/' + String(d2.getDate()).padStart(2,'0');
            fetch(GAS_URL, {
              method: 'POST', mode: 'cors',
              headers: { 'Content-Type': 'text/plain' },
              body: JSON.stringify({ action: 'punchPA', date: ds2, name: currentEmp.name, dept: currentEmp.dept, type: type, time: t, overwrite: true }),
            }).catch(() => {});
          }
        }
      })
      .catch(() => {});
    }

    function showPunch() { showScreen('screen-punch'); }

    function showApply() {
      const d = new Date();
      const y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,'0'), day = String(d.getDate()).padStart(2,'0');
      document.getElementById('apply-date').value = y + '-' + m + '-' + day;
      document.getElementById('apply-note').value = '';
      const sel = document.getElementById('apply-time');
      sel.innerHTML = '<option value="">-- 選択してください --</option>';
      for (let h = 6; h <= 23; h++) {
        for (let min = 0; min < 60; min += 15) {
          const opt = document.createElement('option');
          opt.value = String(h).padStart(2,'0') + ':' + String(min).padStart(2,'0');
          opt.textContent = opt.value;
          sel.appendChild(opt);
        }
      }
      selectApplyType('出勤');
      showScreen('screen-apply');
    }

    function selectApplyType(type) {
      applyType = type;
      const inBtn = document.getElementById('apply-in-btn');
      const outBtn = document.getElementById('apply-out-btn');
      if (type === '出勤') {
        inBtn.style.background='#E1F5EE'; inBtn.style.color='#0F6E56'; inBtn.style.fontWeight='600';
        outBtn.style.background='#f9f9f7'; outBtn.style.color='#6b6b68'; outBtn.style.fontWeight='400';
      } else {
        outBtn.style.background='#FAECE7'; outBtn.style.color='#993C1D'; outBtn.style.fontWeight='600';
        inBtn.style.background='#f9f9f7'; inBtn.style.color='#6b6b68'; inBtn.style.fontWeight='400';
      }
    }

    function submitApply() {
      const dateVal = document.getElementById('apply-date').value;
      const timeVal = document.getElementById('apply-time').value;
      const note = document.getElementById('apply-note').value;
      if (!dateVal) { alert('申請日を選択してください'); return; }
      if (!timeVal) { alert('希望時刻を選択してください'); return; }
      if (!note.trim()) { alert('理由を入力してください'); return; }
      const dateStr = dateVal.replace(/-/g, '/');
      fetch(GAS_URL, {
        method: 'POST', mode: 'cors',
        headers: { 'Content-Type': 'text/plain' },
        body: JSON.stringify({ action: 'apply', name: currentEmp.name, dept: currentEmp.dept, date: dateStr, type: applyType, time: timeVal, note: note }),
      })
      .then(r => r.json())
      .then(res => {
        if (res.status === 'ok') { alert('✅ 申請を送信しました'); showPunch(); }
        else { alert('エラー: ' + res.message); }
      })
      .catch(() => { alert('✅ 申請を送信しました'); showPunch(); });
    }

    function logout() {
      currentEmp = null; pinBuffer = ''; todayIn = null; todayOut = null; prevDayNoOut = false;
      updateDots();
      document.getElementById('pin-error').textContent = '';
      showScreen('screen-pin');
    }

    function tick() {
      const d = new Date();
      document.getElementById('clock').textContent = d.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const wd = ['日','月','火','水','木','金','土'][d.getDay()];
      document.getElementById('datestr').textContent = d.getFullYear() + ' / ' + String(d.getMonth()+1).padStart(2,'0') + ' / ' + String(d.getDate()).padStart(2,'0') + '（' + wd + '）';
    }
    setInterval(tick, 1000); tick();
  </script>
</body>
