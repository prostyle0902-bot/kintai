      { pin: '4582', name: '篠塚柚紀',    dept: 'りゅうちゃん',        locs: [{ lat: 35.8998, lng: 140.6404, name: '神栖横丁', radius: 300 }] },
      { pin: '4811', name: '篠田麻里奈',  dept: 'りゅうちゃん',        locs: [{ lat: 35.8998, lng: 140.6404, name: '神栖横丁', radius: 300 }] },
      { pin: '9279', name: '林沙樹',      dept: 'りゅうちゃん',        locs: [{ lat: 35.8998, lng: 140.6404, name: '神栖横丁', radius: 300 }] },
      { pin: '1434', name: '須之内郁美',  dept: 'りゅうちゃん',        locs: [{ lat: 35.8998, lng: 140.6404, name: '神栖横丁', radius: 300 }] },
