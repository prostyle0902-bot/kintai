      { pin: '3615', name: '長谷川碧里',  dept: 'トータルステイ',      locs: [{ lat: 35.9048, lng: 140.6358, name: 'トータルステイ', radius: 300 }] },
      { pin: '7924', name: '松本めぐみ',  dept: 'トータルステイ',      locs: [{ lat: 35.9048, lng: 140.6358, name: 'トータルステイ', radius: 300 }] },
      { pin: '6574', name: '田村あつ子',  dept: 'トータルステイ',      locs: [{ lat: 35.9048, lng: 140.6358, name: 'トータルステイ', radius: 300 }] },
      { pin: '5552', name: '衣幡千明',    dept: 'トータルステイ',      locs: [{ lat: 35.9048, lng: 140.6358, name: 'トータルステイ', radius: 300 }] },
