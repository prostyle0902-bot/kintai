<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Prostyle PA勤怠</title>
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="PA勤怠" />
  <link rel="icon" type="image/png" href="data:image/png;base64," />
  <link rel="apple-touch-icon" href="data:image/png;base64," />
  <meta name="theme-color" content="#783c14" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f5f4f0;
      --surface: #ffffff;
      --border: rgba(0,0,0,0.1);
      --border-md: rgba(0,0,0,0.18);
      --text-primary: #1a1a18;
      --text-secondary: #6b6b68;
      --text-danger: #a32d2d;
      --radius-md: 8px;
      --radius-lg: 12px;
      --accent: #783c14;
    }
    body {
      font-family: -apple-system, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
      background: var(--bg);
      min-height: 100vh;
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }
    .app { width: 100%; max-width: 420px; padding: 2rem 1.25rem 3rem; }
    .logo { text-align: center; margin-bottom: 2rem; }
    .logo-title { font-size: 20px; font-weight: 600; color: var(--accent); letter-spacing: 0.06em; }
    .logo-sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; }
    .screen { display: none; }
    .screen.active { display: block; }
    .card { background: var(--surface); border: 0.5px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 1rem; }
    .pin-label { font-size: 13px; color: var(--text-secondary); margin-bottom: 1rem; text-align: center; }
    .pin-display { display: flex; justify-content: center; gap: 12px; margin-bottom: 1.5rem; }
    .pin-dot { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--border-md); background: transparent; transition: background 0.15s; }
    .pin-dot.filled { background: var(--accent); border-color: var(--accent); }
    .error-msg { text-align: center; font-size: 13px; color: var(--text-danger); height: 18px; margin-bottom: 0.75rem; }
    .pin-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .pin-btn { height: 60px; border: 0.5px solid var(--border); border-radius: var(--radius-md); background: #f9f9f7; font-size: 22px; font-weight: 500; color: var(--text-primary); cursor: pointer; transition: all 0.1s; display: flex; align-items: center; justify-content: center; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
    .pin-btn:active { transform: scale(0.94); background: #ebebea; }
    .pin-btn.zero { grid-column: 2; }
    .emp-name { font-size: 17px; font-weight: 600; color: var(--text-primary); margin-bottom: 6px; }
    .dept-badge { display: inline-block; font-size: 11px; padding: 3px 12px; border-radius: 20px; margin-bottom: 1.5rem; font-weight: 500; background: #FFF3E0; color: #783c14; }
    .time-display { font-size: 36px; font-weight: 600; color: var(--text-primary); text-align: center; margin-bottom: 4px; font-variant-numeric: tabular-nums; }
    .date-display { font-size: 13px; color: var(--text-secondary); text-align: center; margin-bottom: 1.75rem; }
    .punch-btns { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 1rem; }
    .punch-btn { height: 80px; border-radius: var(--radius-lg); font-size: 17px; font-weight: 600; cursor: pointer; border: none; transition: all 0.15s; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
    .punch-btn svg { width: 24px; height: 24px; }
    .punch-btn.in { background: #E1F5EE; color: #0F6E56; }
    .punch-btn.in:active { background: #9FE1CB; transform: scale(0.96); }
    .punch-btn.out { background: #FAECE7; color: #993C1D; }
    .punch-btn.out:active { background: #F5C4B3; transform: scale(0.96); }
    .punch-btn:disabled { opacity: 0.3; cursor: not-allowed; }
    .status-box { background: #f9f9f7; border-radius: var(--radius-md); padding: 12px 16px; font-size: 13px; }
    .status-row { display: flex; justify-content: space-between; color: var(--text-secondary); padding: 4px 0; }
    .status-row span:last-child { color: var(--text-primary); font-weight: 500; }
    .apply-btn { width: 100%; margin-top: 1rem; padding: 11px; border: 0.5px solid #d4a017; border-radius: var(--radius-md); background: #fffbeb; color: #92650a; font-size: 13px; cursor: pointer; }
    .logout-btn { width: 100%; margin-top: 0.5rem; padding: 11px; border: 0.5px solid var(--border); border-radius: var(--radius-md); background: transparent; color: var(--text-secondary); font-size: 13px; cursor: pointer; }
    .result-card { background: var(--surface); border-radius: var(--radius-lg); border: 0.5px solid var(--border); padding: 2.5rem 1.5rem; text-align: center; }
    .result-icon { font-size: 52px; margin-bottom: 1rem; }
    .result-title { font-size: 20px; font-weight: 600; color: var(--text-primary); margin-bottom: 6px; }
    .result-sub { font-size: 14px; color: var(--text-secondary); margin-bottom: 2rem; }
    .back-btn { padding: 11px 28px; border: 0.5px solid var(--border-md); border-radius: var(--radius-md); background: transparent; color: var(--text-primary); font-size: 14px; cursor: pointer; }
  </style>
</head>
<body>
  <div class="app">
    <div class="logo">
      <div class="logo-title">Prostyle PA勤怠</div>
      <div class="logo-sub">パート・アルバイト専用</div>
    </div>

    <!-- PIN入力画面 -->
    <div class="screen active" id="screen-pin">
      <div class="card">
        <div class="pin-label">PINコードを入力してください</div>
        <div class="pin-display">
          <div class="pin-dot" id="d0"></div>
          <div class="pin-dot" id="d1"></div>
          <div class="pin-dot" id="d2"></div>
          <div class="pin-dot" id="d3"></div>
        </div>
        <div class="error-msg" id="pin-error"></div>
        <div class="pin-grid">
          <button class="pin-btn" onclick="pinInput('1')">1</button>
          <button class="pin-btn" onclick="pinInput('2')">2</button>
          <button class="pin-btn" onclick="pinInput('3')">3</button>
          <button class="pin-btn" onclick="pinInput('4')">4</button>
          <button class="pin-btn" onclick="pinInput('5')">5</button>
          <button class="pin-btn" onclick="pinInput('6')">6</button>
          <button class="pin-btn" onclick="pinInput('7')">7</button>
          <button class="pin-btn" onclick="pinInput('8')">8</button>
          <button class="pin-btn" onclick="pinInput('9')">9</button>
          <button class="pin-btn zero" onclick="pinInput('0')">0</button>
          <button class="pin-btn" onclick="pinDel()">⌫</button>
        </div>
      </div>
    </div>

    <!-- 打刻画面 -->
    <div class="screen" id="screen-punch">
      <div class="card">
        <div class="emp-name" id="emp-name"></div>
        <div class="dept-badge" id="emp-dept-badge"></div>
        <div class="time-display" id="clock">--:--:--</div>
        <div class="date-display" id="datestr"></div>
        <div class="punch-btns">
          <button class="punch-btn in" id="btn-in" onclick="punch('出勤')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            出勤
          </button>
          <button class="punch-btn out" id="btn-out" onclick="punch('退勤')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            退勤
          </button>
        </div>
        <div class="status-box">
          <div class="status-row"><span>本日の出勤</span><span id="st-in">未打刻</span></div>
          <div class="status-row"><span>本日の退勤</span><span id="st-out">未打刻</span></div>
        </div>
        <button class="apply-btn" onclick="showApply()">打刻忘れ申請</button>
        <button class="logout-btn" onclick="logout()">ログアウト</button>
      </div>
    </div>

    <!-- 打刻完了画面 -->
    <div class="screen" id="screen-done">
      <div class="result-card">
        <div class="result-icon" id="done-icon">✅</div>
        <div class="result-title" id="done-title"></div>
        <div class="result-sub" id="done-time"></div>
        <button class="back-btn" onclick="showPunch()">戻る</button>
      </div>
    </div>

    <!-- 打刻忘れ申請画面 -->
    <div class="screen" id="screen-apply">
      <div class="card">
        <div style="font-size:15px;font-weight:600;color:var(--text-primary);margin-bottom:4px;">打刻忘れ申請</div>
        <div style="font-size:12px;color:var(--text-secondary);margin-bottom:1.25rem;">申請内容を選んで送信してください。時刻は管理者が確認・入力します。</div>
        <div style="font-size:13px;color:var(--text-secondary);margin-bottom:6px;">申請日</div>
        <input type="date" id="apply-date" style="width:100%;padding:10px;border:0.5px solid var(--border-md);border-radius:var(--radius-md);font-size:14px;margin-bottom:1rem;background:var(--surface);" />
        <div style="font-size:13px;color:var(--text-secondary);margin-bottom:6px;">申請種別</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:1rem;">
          <button id="apply-in-btn" onclick="selectApplyType('出勤')" style="padding:12px;border:0.5px solid var(--border);border-radius:var(--radius-md);background:#E1F5EE;color:#0F6E56;font-size:14px;font-weight:600;cursor:pointer;">出勤</button>
          <button id="apply-out-btn" onclick="selectApplyType('退勤')" style="padding:12px;border:0.5px solid var(--border);border-radius:var(--radius-md);background:#f9f9f7;color:var(--text-secondary);font-size:14px;cursor:pointer;">退勤</button>
        </div>
        <div style="font-size:13px;color:var(--text-secondary);margin-bottom:6px;">希望時刻</div>
        <select id="apply-time" style="width:100%;padding:10px;border:0.5px solid var(--border-md);border-radius:var(--radius-md);font-size:14px;margin-bottom:1rem;background:var(--surface);">
          <option value="">-- 選択してください --</option>
        </select>
        <div style="font-size:13px;color:var(--text-secondary);margin-bottom:6px;">理由 <span style="color:#a32d2d;font-size:11px;">必須</span></div>
        <textarea id="apply-note" placeholder="例：現場直行のため打刻できませんでした" style="width:100%;padding:10px;border:0.5px solid var(--border-md);border-radius:var(--radius-md);font-size:13px;height:80px;resize:none;margin-bottom:1.25rem;"></textarea>
        <button onclick="submitApply()" style="width:100%;padding:12px;border:none;border-radius:var(--radius-md);background:var(--accent);color:#fff;font-size:14px;font-weight:600;cursor:pointer;margin-bottom:0.5rem;">申請を送信</button>
        <button onclick="showPunch()" style="width:100%;padding:10px;border:0.5px solid var(--border);border-radius:var(--radius-md);background:transparent;color:var(--text-secondary);font-size:13px;cursor:pointer;">キャンセル</button>
      </div>
    </div>
  </div>

  <script>
    const GAS_URL = 'YOUR_GAS_WEB_APP_URL';

    const employees = [
      { pin: '2824', name: '小林メグ',    dept: '焼きたて屋',         locs: [{ lat: 35.9831, lng: 140.6368, name: '焼きたて屋', radius: 300 }] },
      { pin: '1409', name: '荒宏信',      dept: '焼きたて屋',         locs: [{ lat: 35.9831, lng: 140.6368, name: '焼きたて屋', radius: 300 }] },
      { pin: '5506', name: '松岡実麻',    dept: 'タコハイ',            locs: [{ lat: 35.8998, lng: 140.6404, name: '神栖横丁', radius: 300 }] },
      { pin: '5012', name: '石井義則',    dept: 'バッシング',          locs: [{ lat: 35.8998, lng: 140.6404, name: '神栖横丁', radius: 300 }] },
