      { pin: '4527', name: '山田明子',    dept: '市川東病院',          locs: [{ lat: 35.7034, lng: 139.9589, name: '市川東病院', radius: 300 }] },
      { pin: '6514', name: '伊藤美津子',  dept: '市川東病院',          locs: [{ lat: 35.7034, lng: 139.9589, name: '市川東病院', radius: 300 }] },
      { pin: '2674', name: '桜庭京子',    dept: '海事・横河',          locs: [{ lat: 35.8885, lng: 140.6527, name: '海事・横河', radius: 300 }] },
      { pin: '2519', name: '小倉孔子',    dept: 'ちば醤油',            locs: [{ lat: 35.8569, lng: 140.5562, name: 'ちば醤油', radius: 300 }] },
      { pin: '7224', name: '齊藤良江',    dept: '神宮・亀甲堂・ゆう屋', locs: null },
      { pin: '2584', name: '宮嵜博之',    dept: '香取神宮',            locs: [{ lat: 35.8862, lng: 140.5287, name: '香取神宮', radius: 300 }] },
      { pin: '6881', name: '千葉規雄',    dept: 'ニッセーデリカ',      locs: null },
